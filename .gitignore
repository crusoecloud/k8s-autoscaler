# OSX leaves these everywhere on SMB shares
._*

# OSX trash
.DS_Store

# Eclipse files
.classpath
.project
.settings/**

# Files generated by JetBrains IDEs, e.g. IntelliJ IDEA
.idea/
*.iml

# VSCode project files
**/.vscode
*.code-workspace

# Emacs save files
*~
\#*\#
.\#*

# Vim-related files
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Binary files
bin/

# mise/CI state; keep the upstream committed vendor trees intact.
.mise-data/
.cache/
**/coverage.out
**/coverage.out.tmp
**/coverage.html
**/coverage.xml
**/junit.xml
**/gl-code-quality-report.json
